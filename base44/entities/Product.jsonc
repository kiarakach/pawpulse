{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Smart Feeders",
        "GPS Trackers",
        "Health Monitors",
        "Accessories"
      ]
    },
    "price": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "category",
    "price"
  ]
}