{
  "name": "CommunityPost",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "pet_name": {
      "type": "string"
    },
    "species": {
      "type": "string",
      "enum": [
        "dog",
        "cat"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "tip": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "author_name",
    "caption"
  ]
}