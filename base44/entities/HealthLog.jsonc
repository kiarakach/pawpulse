{
  "name": "HealthLog",
  "type": "object",
  "properties": {
    "pet_id": {
      "type": "string"
    },
    "pet_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Vet Visit",
        "Vaccination",
        "Medication"
      ]
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "pet_id",
    "type",
    "title"
  ]
}