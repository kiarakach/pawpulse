# Supabase (frontend) — safe to expose; RLS enforces access.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- server-side only (Supabase Edge Function secrets / migration scripts) ---
# Do NOT prefix these with VITE_ and never expose them to the browser.
# Set these with:  supabase secrets set NAME=value
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# invoke-llm (LLM backend, any OpenAI-compatible provider):
# Currently using Google Gemini free tier:
# LLM_API_KEY=AQ.Ab8...                                          # Google AI Studio key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-flash-lite-latest                            # lite = healthy free daily quota
#
# Alternative (OpenRouter open-source models):
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1                     # this is the code default
# LLM_MODEL=google/gemma-4-31b-it:free
#
# send-push (native push notifications — server-to-server only):
# PUSH_SECRET=long-random-string                                # shared secret; cron sends it as x-push-secret
# APNS_KEY_ID=XXXXXXXXXX                                        # 10-char id of the .p8 APNs key
# APNS_TEAM_ID=XXXXXXXXXX                                       # Apple Developer Team ID
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_BUNDLE_ID=com.getpawpulse.app                              # APNs topic
# APNS_ENV=sandbox                                             # sandbox for TestFlight, production for App Store
# FCM_SERVICE_ACCOUNT={...}                                    # (Android) Firebase service-account JSON
# FCM_PROJECT_ID=your-firebase-project-id                      # (Android)
